---
import BaseHead from "../../components/BaseHead.astro";
import ArticleFeed from "../../components/ArticleFeed.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead
      title={`Blog Archive — ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
    />
  </head>
  <body
    class="bg-surface-paper dark:bg-surface-dark text-neutral-800 dark:text-[#e4e4e7] antialiased min-h-screen flex flex-col font-sans"
  >
    <ArticleFeed />
  </body>
</html>
