---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import SearchModal from "./SearchModal.astro";
import Toast from "./Toast.astro";
import { getAuthorProfile } from "../consts";
import { calculateReadingTime } from "../helpers/readingTime";

interface Props {
  posts?: CollectionEntry<"blog">[];
}

const allPosts =
  Astro.props.posts ??
  (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

// Extract distinct tags across all articles
const uniqueTags = Array.from(
  new Set(allPosts.flatMap((post) => post.data.tags ?? []))
);
---

<div class="bg-surface-paper dark:bg-surface-dark text-neutral-800 dark:text-[#e4e4e7] min-h-screen flex flex-col font-sans selection:bg-emerald-500/20 selection:text-emerald-900 dark:selection:text-emerald-300">
  <Navbar>
    <!-- Editorial Hashtag Badge Filter Bar -->
    <div
      slot="subnav"
      class="border-t border-neutral-200/60 dark:border-neutral-800/60 bg-surface-paper/95 dark:bg-surface-dark/95"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="flex items-center gap-2 overflow-x-auto no-scrollbar py-2.5 text-xs font-mono"
        >
          <button
            type="button"
            class="topic-filter-btn px-3 py-1 rounded-full whitespace-nowrap bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 font-semibold transition-colors cursor-pointer"
            data-topic="all"
          >
            #all
          </button>
          {
            uniqueTags.map((tag) => (
              <button
                type="button"
                class="topic-filter-btn px-3 py-1 rounded-full whitespace-nowrap text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-200/50 dark:hover:bg-neutral-800/50 transition-colors cursor-pointer"
                data-topic={tag.toLowerCase()}
              >
                #{tag}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </Navbar>

  <!-- Main Centered Editorial Feed -->
  <main class="flex-grow max-w-3xl mx-auto px-4 sm:px-6 py-10 w-full space-y-10">
    <!-- Stories Stream -->
    <section class="space-y-9" id="storiesFeed">
      {
        allPosts.map((post) => {
          const categoryString = (post.data.tags ?? []).join(" ").toLowerCase();
          const hasImage = Boolean(post.data.heroImage);
          const authorProfile = getAuthorProfile(post.data.author);

          return (
            <article
              class="feed-card group pb-9 border-b border-neutral-200/70 dark:border-neutral-800/70"
              data-categories={categoryString}
            >
              <div class="flex gap-5 sm:gap-6 items-start">
                <div class="flex-1">
                  <!-- Author Meta -->
                  <div class="flex items-center gap-2 mb-2">
                    <img
                      src={authorProfile.avatar}
                      alt={authorProfile.name}
                      class="w-5 h-5 rounded-full object-cover"
                    />
                    <span class="text-xs font-semibold text-neutral-900 dark:text-neutral-200">
                      {authorProfile.name}
                    </span>
                    <span class="text-neutral-300 dark:text-neutral-700">•</span>
                    <time class="text-xs text-neutral-500 font-mono">
                      <FormattedDate date={post.data.pubDate} />
                    </time>
                  </div>

                  <!-- Title -->
                  <a href={`/blog/${post.id}/`} class="block group">
                    <h3 class="article-serif text-lg sm:text-xl font-bold text-neutral-900 dark:text-white leading-snug tracking-tight group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                      {post.data.title}
                    </h3>
                  </a>

                  <!-- Excerpt -->
                  <p class="mt-1.5 text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed line-clamp-2">
                    {post.data.description}
                  </p>

                  <!-- Card Footer Tags & Read Time -->
                  <div class="mt-3 flex items-center gap-3 text-xs text-neutral-500">
                    {post.data.tags && post.data.tags.length > 0 && (
                      <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
                        #{post.data.tags[0]}
                      </span>
                    )}
                    <span>{calculateReadingTime(post.body)}</span>
                  </div>
                </div>

                {hasImage && post.data.heroImage && (
                  <div class="w-24 h-20 sm:w-36 sm:h-24 rounded-lg overflow-hidden shrink-0 bg-neutral-100 dark:bg-neutral-800">
                    <Image
                      src={post.data.heroImage}
                      alt={post.data.title}
                      width={400}
                      height={260}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  </div>
                )}
              </div>
            </article>
          );
        })
      }
    </section>
  </main>

  <Footer />
  <SearchModal />
  <Toast />
</div>

<script is:inline>
  // Live hashtag filter buttons logic
  const filterButtons = document.querySelectorAll(".topic-filter-btn");
  const feedCards = document.querySelectorAll(".feed-card");

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      // Inactive button styles
      filterButtons.forEach((b) => {
        b.className =
          "topic-filter-btn px-3 py-1 rounded-full whitespace-nowrap text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-200/50 dark:hover:bg-neutral-800/50 transition-colors cursor-pointer";
      });
      // Active button style
      btn.className =
        "topic-filter-btn px-3 py-1 rounded-full whitespace-nowrap bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 font-semibold transition-colors cursor-pointer";

      const selectedTopic = btn.getAttribute("data-topic");
      feedCards.forEach((card) => {
        const cardCategories = (
          card.getAttribute("data-categories") || ""
        ).split(" ");
        if (selectedTopic === "all" || cardCategories.includes(selectedTopic)) {
          card.style.display = "block";
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>

