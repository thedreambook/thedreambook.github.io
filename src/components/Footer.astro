---
const currentYear = new Date().getFullYear();
---

<footer
  class="border-t border-neutral-200 dark:border-neutral-800 py-8 bg-neutral-100/40 dark:bg-surface-darker text-neutral-500 text-xs font-mono mt-auto"
>
  <div
    class="max-w-3xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4"
  >
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
      <span>Independent editorial engineering log. Clean & minimal reading.</span>
    </div>
    <div class="flex items-center gap-5">
      <a
        href="/blog"
        class="hover:text-neutral-900 dark:hover:text-white transition-colors"
      >
        Archive
      </a>
      <a
        href="https://github.com/wuttinanhi"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-neutral-900 dark:hover:text-white transition-colors"
      >
        GitHub
      </a>
      <a
        href="/about"
        class="hover:text-neutral-900 dark:hover:text-white transition-colors"
      >
        About
      </a>
    </div>
  </div>
</footer>
