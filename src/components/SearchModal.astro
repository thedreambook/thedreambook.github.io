---
import { getCollection } from "astro:content";

// Retrieve all posts to populate client-side spotlight search
const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const searchablePosts = allPosts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags ?? [],
  pubDate: post.data.pubDate.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
}));

// Collect unique tags for suggestion tags in the modal
const uniqueTags = Array.from(
  new Set(allPosts.flatMap((post) => post.data.tags ?? []))
).slice(0, 6);
---

<div
  id="searchModal"
  class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 hidden flex items-start justify-center pt-20 px-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="searchModalTitle"
>
  <div
    class="bg-white dark:bg-surface-cardDark border border-neutral-200 dark:border-neutral-700/80 rounded-2xl w-full max-w-lg shadow-2xl overflow-hidden flex flex-col max-h-[80vh]"
  >
    <div
      class="p-4 border-b border-neutral-200 dark:border-neutral-800 flex items-center gap-3 shrink-0"
    >
      <svg
        class="w-5 h-5 text-neutral-400 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input
        id="searchInputField"
        type="text"
        placeholder="Search systems, Rust, architecture, tutorials..."
        class="w-full bg-transparent text-sm focus:outline-hidden text-neutral-900 dark:text-white placeholder:text-neutral-400"
        autocomplete="off"
      />
      <span
        class="text-[11px] font-mono text-neutral-400 border border-neutral-300 dark:border-neutral-700 px-1.5 py-0.5 rounded shrink-0 select-none"
      >
        ESC
      </span>
    </div>

    <!-- Suggested Quick Tags -->
    <div
      id="searchTagsContainer"
      class="p-3 text-xs text-neutral-500 border-b border-neutral-100 dark:border-neutral-800/80 shrink-0"
    >
      <p
        class="font-semibold text-neutral-400 uppercase tracking-wider mb-2 font-mono text-[10px]"
        id="searchModalTitle"
      >
        Filter by topics
      </p>
      <div class="flex flex-wrap gap-1.5">
        {
          uniqueTags.map((tag) => (
            <button
              type="button"
              class="search-tag px-2.5 py-1 bg-neutral-100 dark:bg-neutral-800 hover:bg-emerald-50 dark:hover:bg-emerald-950/50 hover:text-emerald-600 dark:hover:text-emerald-400 rounded-md cursor-pointer transition-colors text-xs font-mono"
            >
              #{tag}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Search Results List -->
    <div
      id="searchResultsList"
      class="p-2 overflow-y-auto divide-y divide-neutral-100 dark:divide-neutral-800/60"
    >
      <!-- Results injected by JavaScript below -->
    </div>
  </div>
</div>

<script is:inline define:vars={{ searchablePosts }}>
  const searchModal = document.getElementById("searchModal");
  const searchInputField = document.getElementById("searchInputField");
  const searchResultsList = document.getElementById("searchResultsList");
  const searchTags = document.querySelectorAll(".search-tag");

  /**
   * Opens the spotlight search dialog and focuses the input.
   */
  function openSearch() {
    if (!searchModal) return;
    searchModal.classList.remove("hidden");
    renderResults(searchInputField.value || "");
    setTimeout(() => searchInputField && searchInputField.focus(), 60);
  }

  /**
   * Closes the spotlight search dialog.
   */
  function closeSearch() {
    if (!searchModal) return;
    searchModal.classList.add("hidden");
  }

  /**
   * Renders matching post results into the search modal container.
   * @param {string} query - Keyword filter.
   */
  function renderResults(query) {
    if (!searchResultsList) return;
    const trimmed = query.trim().toLowerCase().replace(/^#/, "");

    const matches = searchablePosts.filter((post) => {
      if (!trimmed) return true;
      return (
        post.title.toLowerCase().includes(trimmed) ||
        post.description.toLowerCase().includes(trimmed) ||
        post.tags.some((tag) => tag.toLowerCase().includes(trimmed))
      );
    });

    if (matches.length === 0) {
      searchResultsList.innerHTML = `
        <div class="py-8 text-center text-xs text-neutral-400 font-mono">
          No matching articles found for "${query}"
        </div>
      `;
      return;
    }

    searchResultsList.innerHTML = matches
      .map(
        (post) => `
        <a href="/blog/${post.slug}/" class="block p-3 rounded-lg hover:bg-neutral-100/80 dark:hover:bg-neutral-800/60 transition-colors group">
          <div class="flex items-center justify-between gap-2">
            <h4 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-1">
              ${post.title}
            </h4>
            <span class="text-[11px] font-mono text-neutral-400 shrink-0">${post.pubDate}</span>
          </div>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 line-clamp-2">
            ${post.description}
          </p>
        </a>
      `
      )
      .join("");
  }

  if (searchInputField) {
    searchInputField.addEventListener("input", (e) => {
      renderResults(e.target.value);
    });
  }

  // Keyboard shortcut listener for ⌘K, Ctrl+K, and Escape
  window.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (searchModal.classList.contains("hidden")) {
        openSearch();
      } else {
        closeSearch();
      }
    }
    if (e.key === "Escape" && !searchModal.classList.contains("hidden")) {
      closeSearch();
    }
  });

  if (searchModal) {
    searchModal.addEventListener("click", (e) => {
      if (e.target === searchModal) closeSearch();
    });
  }

  // Listen to search trigger buttons across pages
  document.addEventListener("click", (e) => {
    const trigger = e.target.closest("#searchTriggerBtn");
    if (trigger) {
      e.preventDefault();
      openSearch();
    }
  });

  // Clicking quick topic tags
  searchTags.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tagText = btn.innerText.trim();
      searchInputField.value = tagText;
      renderResults(tagText);
      searchInputField.focus();
    });
  });
</script>

