---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import SearchModal from "../components/SearchModal.astro";
import Toast from "../components/Toast.astro";
import { AUTHOR_NAME, AUTHOR_AVATAR, AUTHOR_BIO, SITE_TITLE } from "../consts";
import { calculateReadingTime } from "../helpers/readingTime";

type Props = CollectionEntry<"blog">["data"] & {
  body?: string;
};

const { title, description, pubDate, updatedDate, heroImage, tags, body } =
  Astro.props;

const readingTime = calculateReadingTime(body);
const primaryTag = tags && tags.length > 0 ? tags[0] : "Article";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead
      title={`${title} — ${SITE_TITLE}`}
      description={description}
      image={heroImage}
    />
  </head>

  <body
    class="bg-surface-paper dark:bg-surface-dark text-neutral-800 dark:text-[#e4e4e7] antialiased min-h-screen relative flex flex-col font-sans selection:bg-emerald-500/20 selection:text-emerald-900 dark:selection:text-emerald-300"
  >
    <!-- Reading Progress Indicator (Fixed 2px top bar) -->
    <div
      class="fixed top-0 left-0 w-full h-[2px] bg-transparent z-50 pointer-events-none"
    >
      <div
        id="readingProgress"
        class="h-full bg-emerald-600 dark:bg-emerald-400 w-0 transition-all duration-75 ease-out shadow-[0_0_8px_rgba(16,185,129,0.5)]"
      >
      </div>
    </div>

    <!-- Header Navigation -->
    <Navbar />

    <!-- Focused Editorial Reading Canvas -->
    <main
      class="flex-grow w-full max-w-[760px] mx-auto px-5 sm:px-6 pt-12 pb-20"
    >
      <!-- Topic Pill -->
      <div class="mb-4">
        <span
          class="inline-block text-[11px] font-mono font-semibold tracking-wider text-emerald-700 dark:text-emerald-400 uppercase bg-emerald-50 dark:bg-emerald-950/60 px-2.5 py-0.5 rounded-full border border-emerald-200/60 dark:border-emerald-800/40"
        >
          #{primaryTag}
        </span>
      </div>

      <!-- Headline -->
      <h1
        class="text-3xl sm:text-4xl md:text-[40px] font-bold tracking-tight text-neutral-900 dark:text-white leading-[1.2] mb-4"
      >
        {title}
      </h1>

     

      <!-- Author Metadata Bar -->
      <div
        class="flex items-center justify-between py-4 border-y border-neutral-200/80 dark:border-neutral-800/80 mb-10"
      >
        <div class="flex items-center gap-3">
          <img
            src={AUTHOR_AVATAR}
            alt={AUTHOR_NAME}
            class="w-11 h-11 rounded-full object-cover ring-2 ring-emerald-500/20"
          />
          <div>
            <div class="flex items-center gap-2">
              <span
                class="text-sm font-semibold text-neutral-900 dark:text-neutral-100"
              >
                {AUTHOR_NAME}
              </span>
              <span class="text-neutral-300 dark:text-neutral-700">•</span>
              <a
                href="https://github.com/wuttinanhi"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors"
              >
                GitHub
              </a>
            </div>
            <p
              class="text-xs text-neutral-500 dark:text-neutral-400 flex items-center gap-1.5 pt-0.5 font-sans"
            >
              <time datetime={pubDate.toISOString()}>
                <FormattedDate date={pubDate} />
              </time>
              {
                updatedDate && (
                  <span>
                    (Updated <FormattedDate date={updatedDate} />)
                  </span>
                )
              }
              <span>•</span>
              <span>{readingTime}</span>
            </p>
          </div>
        </div>
      </div>

      <!-- Hero Image -->
      {
        heroImage && (
          <div class="mb-10 rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-800 shadow-xs">
            <Image
              src={heroImage}
              alt={title}
              width={1024}
              height={512}
              class="w-full h-auto object-cover"
            />
          </div>
        )
      }

      <!-- Article Content -->
      <article
        class="article-serif article-content text-[19px] leading-[1.8] text-neutral-800 dark:text-neutral-200"
      >

      <!-- Subtitle / Dek -->
      {
        description && (
          <p class="text-lg sm:text-xl text-neutral-600 dark:text-neutral-300 font-normal leading-relaxed mb-10">
            {description}
          </p>
        )
      }

        <slot />
      </article>

      <!-- Post Article Tags -->
      {
        tags && tags.length > 0 && (
          <div class="mt-12 pt-6 border-t border-neutral-200/80 dark:border-neutral-800/80 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a
                href={`/blog#${tag}`}
                class="px-3 py-1.5 rounded-full text-xs font-mono bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }

      <!-- Author Profile Expanded Card -->
      <div
        class="mt-12 p-6 rounded-2xl bg-neutral-100/70 dark:bg-surface-cardDark/60 border border-neutral-200/80 dark:border-neutral-800 flex flex-col sm:flex-row items-start gap-5"
      >
        <img
          src={AUTHOR_AVATAR}
          alt={AUTHOR_NAME}
          class="w-16 h-16 rounded-full object-cover ring-2 ring-emerald-500/20"
        />
        <div class="flex-1">
          <div class="flex items-center justify-between mb-1">
            <div>
              <span
                class="text-xs font-mono uppercase text-neutral-400 block tracking-wider"
              >
                Written by
              </span>
              <h4 class="text-lg font-bold text-neutral-900 dark:text-white">
                {AUTHOR_NAME}
              </h4>
            </div>
            <a
              href="https://github.com/wuttinanhi"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-1.5 rounded-full bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 text-xs font-medium hover:opacity-90 transition-opacity"
            >
              GitHub
            </a>
          </div>
          <p
            class="text-sm text-neutral-600 dark:text-neutral-300 mt-2 leading-relaxed"
          >
            {AUTHOR_BIO}
          </p>
        </div>
      </div>
    </main>

    <Footer />
    <SearchModal />
    <Toast />

    <script is:inline>
      // Reading progress bar calculation
      const progressBar = document.getElementById("readingProgress");
      function updateReadingProgress() {
        if (!progressBar) return;
        const totalHeight =
          document.documentElement.scrollHeight - window.innerHeight;
        if (totalHeight > 0) {
          const percentage = Math.min(
            100,
            Math.max(0, (window.scrollY / totalHeight) * 100)
          );
          progressBar.style.width = percentage + "%";
        }
      }
      window.addEventListener("scroll", updateReadingProgress, {
        passive: true,
      });

      // Clap interaction logic with local counter and floating +1 animation
      const clapBtn = document.getElementById("inlineClapBtn");
      const clapCount = document.getElementById("inlineClapCount");
      const clapBadge = document.getElementById("inlineClapBadge");
      const pageKey = "clap_" + window.location.pathname;

      let currentClaps = parseInt(localStorage.getItem(pageKey) || "42", 10);
      if (clapCount) {
        clapCount.innerText = currentClaps.toString();
      }

      if (clapBtn) {
        clapBtn.addEventListener("click", () => {
          currentClaps += 1;
          localStorage.setItem(pageKey, currentClaps.toString());
          if (clapCount) {
            clapCount.innerText = currentClaps.toString();
          }

          if (clapBadge) {
            clapBadge.classList.remove("hidden", "animate-clap-float");
            void clapBadge.offsetWidth; // Trigger reflow
            clapBadge.classList.add("animate-clap-float");
            setTimeout(() => {
              clapBadge.classList.add("hidden");
            }, 750);
          }
        });
      }

      // Share button link copy with toast notification
      const shareBtn = document.getElementById("inlineShareBtn");
      if (shareBtn) {
        shareBtn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            if (typeof window.showToast === "function") {
              window.showToast("Link copied to clipboard");
            }
          } catch {
            if (typeof window.showToast === "function") {
              window.showToast("Failed to copy link");
            }
          }
        });
      }
    </script>
  </body>
</html>
